{
  "name": "battlemap-demo-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:hced": "node scripts/build-hced-conflict-events.mjs",
    "build:cshapes": "node scripts/build-cshapes-snapshots.mjs",
    "check:flags": "node --experimental-strip-types scripts/check-flag-coverage.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude e2e/**",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "slides:dev": "marp --server presentation --theme-set presentation/themes/battlemap-zju.css --html --allow-local-files",
    "slides:html": "node scripts/build-slides.mjs html",
    "slides:pdf": "node scripts/build-slides.mjs pdf",
    "slides:pptx": "node scripts/build-slides.mjs pptx",
    "slides:build": "node scripts/build-slides.mjs all",
    "site:build": "npm run build && npm run slides:build && node scripts/assemble-pages.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "flag-icons": "^7.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@marp-team/marp-cli": "4.4.0",
    "@types/leaflet": "^1.9.17",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "vitest": "^4.1.9"
  }
}
